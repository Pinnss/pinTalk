# systemd unit for pintalk (Ubuntu / Debian and other systemd distros).
# Install: copy to /etc/systemd/system/pintalk.service, then
#   systemctl daemon-reload && systemctl enable --now pintalk
# See docs/INSTALL.en.md / docs/INSTALL.ru.md for the full walkthrough.

[Unit]
Description=pintalk — 1-on-1 WebRTC calls (signaling + TURN + HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/pintalk serve --config /etc/pintalk/config.yaml
WorkingDirectory=/etc/pintalk
Restart=on-failure
RestartSec=5
User=pintalk
Group=pintalk

# Bind :80/:443/:3478 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Hardening: the only place pintalk writes is the certificate cache
# (Let's Encrypt certs, or the self-signed CA/leaf and ACME account key).
ProtectSystem=strict
ReadWritePaths=/etc/pintalk/certs
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
