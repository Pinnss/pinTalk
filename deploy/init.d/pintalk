#!/bin/sh /etc/rc.common
# OpenWrt procd init script for pintalk.
# Install: scp this file to router as /etc/init.d/pintalk, then `chmod +x` and
#   /etc/init.d/pintalk enable && /etc/init.d/pintalk start

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/pintalk
CONF=/etc/pintalk/config.yaml

start_service() {
    [ -x "$PROG" ] || { echo "$PROG not found or not executable" >&2; return 1; }
    [ -f "$CONF" ] || { echo "$CONF not found" >&2; return 1; }

    procd_open_instance
    procd_set_param command "$PROG" serve --config "$CONF"
    procd_set_param respawn 5 30 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    # autocert needs to write into /etc/pintalk/certs; root is fine.
    procd_close_instance
}

reload_service() {
    stop
    start
}
